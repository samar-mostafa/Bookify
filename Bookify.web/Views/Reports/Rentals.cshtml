@model RentalReportViewModel

@{
    ViewData["Title"] = "Rentals Report";
}

<div class="card mb-4">
    <div class="card-body">
        <form asp-controller="Reports" method="get" id="Filters" class="js-excluded-validation">
            <input type="hidden" id="PageNumber" name="PageNumber" value="1" />
           
            <div class="row">
                <div class="col">
                    <div class="mb-5">
                        <div class="form-floating mb-2">
                            <input type="text" name="daterange"  class="form-control js_daterangepicker" autocomplete="off"  />
                            <span asp-validation-for="Duration" class="text-danger d-block"></span>
                        </div>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Show Report</button>
        </form>
    </div>
</div>

@if (Model.Rentals is not null)
{
    <div class="card">
        <div class="card-header">
            <div class="card-title">
                <span>Rentals</span>
            </div>
            @if (Model.Rentals.Any())
            {
                <div class="card-toolbar gap-3">
                    <a class="btn btn-light-success" asp-action="ExportRentalsToExcel"
                       asp-route-fromToDates="@Context.Request.Query["fromToDates"]" >
                        <i class="bi bi-file-earmark-excel-fill"></i>
                        Export to Excel
                    </a>

                    <a class="btn btn-light-danger" asp-action="ExportRentalsToPDF"
                       asp-route-fromToDates="@Context.Request.Query["fromToDates"]">
                        <i class="bi bi-filetype-pdf"></i>
                        Export to PDF
                    </a>
                </div>
            }
        </div>
        <div class="card-body">
            @if (Model.Rentals.TotalPages > 1)
            {
                <partial name="_Pagination" model="new PaginationViewModel { PageNumber = Model.Rentals.PageNumber, TotalPages = Model.Rentals.TotalPages }" />
            }

            @if (Model.Rentals.Any())
            {
                <div class="table-responsive">
                    <table class="table table-row-dashed table-row-gray-300 gy-2 align-middle">
                        <thead>
                            <tr class="fw-bold fs-6 text-white bg-black">
                                <th class="ps-2">Subscriber Id</th>
                                <th>Subscriber Name</th>
                                <th>Subscriber Phone</th>
                                <th>Book Title</th>
                                <th>Book Author</th>
                                <th>Rental Date</th>
                                <th>End Date</th>
                                <th>Return Date</th>
                                <th>Extended on</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rental in Model.Rentals)
                            {
                                <tr>
                                    <td>@rental.Rental.Subscriper.Id</td>
                                    <td>@($"{rental.Rental.Subscriper.FirstName} {rental.Rental.Subscriper.LastName}")</td>
                                    <td>@rental.Rental.Subscriper.MobileNumber</td>
                                    <td>@rental.BookCopy.Book.Title</td>
                                    <td>@rental.BookCopy.Book.Author.Name</td>
                                    <td>@rental.RentalDate.ToString("d MMM, yyyy")</td>
                                    <td>@rental.EndDate.ToString("d MMM, yyyy")</td>
                                    <td>@rental.ReturnDate?.ToString("d MMM, yyyy")</td>
                                    <td>@rental.ExtendDate?.ToString("d MMM, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <h5>No rentals were found!</h5>
            }
        </div>
    </div>
}

@section Scripts
{
    <script src="~/js/reports.js" asp-append-version="true"></script>
}